#!/usr/bin/env bash
# ai-dotfiles — run this repo's installer from any folder (linked into ~/.local/bin).
#
# Usage:
#   ai-dotfiles [install] [flags]   apply the setup (scripts/install.sh)
#   ai-dotfiles update [flags]      pull this repo, then install (install.sh --update)
#   ai-dotfiles uninstall [flags]   remove what points into this repo (scripts/uninstall.sh)
#   ai-dotfiles check               verify live state (scripts/healthcheck.sh)
#   ai-dotfiles worktree <command>  agents' linked worktrees: list, done, rm, prune, release, share
#   ai-dotfiles commit check [args]  the size and message `git commit [args]` would get past the hook
#   ai-dotfiles approve [flags]     land the reviewed branch: every git step below, in order
#   ai-dotfiles git <step> [flags]  one step: push, pr, review, reviewer, tag, merge, prune
#   ai-dotfiles statusline          the status line Claude Code and Antigravity run: session JSON in, lines out
#   Flags pass through, e.g. --dry-run, --target=claude; see each script's --help.

set -euo pipefail

# Follow the ~/.local/bin link back into the checkout.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="$DIR/$SELF" ;; esac
done
SCRIPTS="$(cd "$(dirname "$SELF")" && pwd)"

usage() { sed -n '2,14p' "$SELF" | sed 's/^# \{0,1\}//'; }

COMMAND="${1:-install}"
case "$COMMAND" in
  -h|--help|help) usage; exit 0 ;;
  -*) COMMAND=install ;;  # flags only: install
  *) shift ;;
esac

case "$COMMAND" in
  install) exec bash "$SCRIPTS/install.sh" "$@" ;;
  update) exec bash "$SCRIPTS/install.sh" --update "$@" ;;
  uninstall) exec bash "$SCRIPTS/uninstall.sh" "$@" ;;
  check) exec bash "$SCRIPTS/healthcheck.sh" "$@" ;;
  worktree) exec python3 "$SCRIPTS/../skills/worktree-guard/scripts/worktree_guard.py" "$@" ;;
  commit) exec python3 "$SCRIPTS/../skills/small-commits/scripts/small_commits.py" "$@" ;;
  approve) exec python3 "$SCRIPTS/../skills/git/approve/scripts/approve.py" "$@" ;;
  statusline) exec "${PYTHON:-python3}" "$SCRIPTS/statusline.py" "$@" ;;
  git)
    GIT="$SCRIPTS/../skills/git"
    STEP="${1:-}"
    [ $# -gt 0 ] && shift
    case "$STEP" in
      push) exec python3 "$GIT/push-branch/scripts/push_branch.py" "$@" ;;
      pr) exec python3 "$GIT/open-pr/scripts/open_pr.py" "$@" ;;
      review) exec python3 "$GIT/approve-pr/scripts/approve_pr.py" "$@" ;;
      reviewer) exec python3 "$GIT/approve-pr/scripts/approve_pr.py" reviewer "$@" ;;
      tag) exec python3 "$GIT/archive-tag/scripts/archive_tag.py" "$@" ;;
      merge) exec python3 "$GIT/merge-pr/scripts/merge_pr.py" "$@" ;;
      prune) exec python3 "$GIT/prune-branch/scripts/prune_branch.py" "$@" ;;
      *) printf '[ERR] ai-dotfiles git <step>: push, pr, review, reviewer, tag, merge or prune; got: %s\n' "$STEP" >&2; exit 1 ;;
    esac ;;
  *) printf '[ERR] Unknown command: %s\n' "$COMMAND" >&2; usage >&2; exit 1 ;;
esac
