#!/usr/bin/env bash
# ai-dotfiles — run this repo's installer and its features' commands from any folder (linked into ~/.local/bin).
#
# This script runs the door's own commands: install, update, uninstall, check, statusline and hook.
# Any other word goes to lib/commands.py, which runs the command a feature's feature.json declares
# and prints `ai-dotfiles --help` from the declarations. Flags alone mean install.

set -euo pipefail

# Follow the ~/.local/bin link back into the checkout.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="$DIR/$SELF" ;; esac
done
SCRIPTS="$(cd "$(dirname "$SELF")" && pwd)"

COMMAND="${1:-install}"
case "$COMMAND" in
  -h|--help|help) ;;
  -*) COMMAND=install ;;  # flags only: install
  *) shift ;;
esac

case "$COMMAND" in
  install) exec bash "$SCRIPTS/install.sh" "$@" ;;
  update) exec bash "$SCRIPTS/install.sh" --update "$@" ;;
  uninstall) exec bash "$SCRIPTS/uninstall.sh" "$@" ;;
  check) exec bash "$SCRIPTS/healthcheck.sh" "$@" ;;
  statusline) exec "${PYTHON:-python3}" "$SCRIPTS/statusline.py" "$@" ;;
  hook)
    # The Python the hooks step linked (lib/install/hooks.py), not the pyenv shim that python3
    # resolves to in the session's folder: about 150 ms less per call, and one Python in every
    # project. $PYTHON overrides it; python3 when the link is missing or broken.
    PY="${PYTHON:-${HOME:-}/.local/state/ai-dotfiles/python3}"
    [ -n "${PYTHON:-}" ] || [ -x "$PY" ] || PY=python3
    exec "$PY" "$SCRIPTS/../lib/door.py" hook "$@" ;;
  -h|--help|help) exec "${PYTHON:-python3}" "$SCRIPTS/../lib/commands.py" --help ;;
  *) exec "${PYTHON:-python3}" "$SCRIPTS/../lib/commands.py" "$COMMAND" "$@" ;;
esac
