{
  "version": 2,
  "claude": {
    "enforce": {
      "skipDangerousModePermissionPrompt": false,
      "skipAutoPermissionPrompt": false,
      "statusLine": {
        "type": "command",
        "command": "~/.local/bin/ai-dotfiles statusline",
        "padding": 0
      }
    },
    "default": {
      "model": "opus",
      "effortLevel": "high",
      "advisorModel": "opus"
    }
  },
  "codex": {
    "enforce": {
      "approval_policy": "on-request",
      "sandbox_mode": "workspace-write",
      "tui.status_line": ["current-dir", "git-branch", "model-with-reasoning", "codex-version", "context-remaining"]
    },
    "default": {
      "model": "gpt-6-astra",
      "model_reasoning_effort": "high"
    }
  },
  "pi": {
    "default": {
      "defaultProvider": "openai-codex",
      "defaultModel": "gpt-6-astra"
    }
  },
  "agy": {
    "enforce": {
      "enableTerminalSandbox": true,
      "statusLine": {
        "type": "command",
        "command": "~/.local/bin/ai-dotfiles statusline"
      }
    }
  }
}
