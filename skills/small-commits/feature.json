{
  "version": 1,
  "cloud": true,
  "hooks": {
    "module": "scripts/small_commits.py",
    "order": 20,
    "budget": {"pre": 30},
    "wants": {
      "claude": {"pre": ["shell"]},
      "codex": {"pre": ["shell"]},
      "agy": {"pre": ["shell"]},
      "pi": {"pre": ["shell"]}
    }
  },
  "commands": {
    "commit": {
      "run": "scripts/small_commits.py",
      "usage": "check [args]",
      "help": "the size and message `git commit [args]` would get past the hook"
    }
  }
}
